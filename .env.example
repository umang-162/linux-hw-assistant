# ---------------------------------------------------------------------------
# Linux Hardware Q&A Assistant — configuration (copy to .env and edit)
#   cp .env.example .env
# Everything here is FREE. No OpenAI / Anthropic keys are used anywhere.
# ---------------------------------------------------------------------------

# ===== Default mode: Groq free cloud API (no credit card) ===================
# 1. Sign up at https://console.groq.com  ->  API Keys  ->  Create API Key
# 2. Paste it below.
GROQ_API_KEY=gsk_your_free_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NOTE: Groq retired `llama-3.3-70b-versatile` for free/developer tiers on
# 2026-08-16. Its recommended replacements are `openai/gpt-oss-120b` or
# `qwen/qwen3.6-27b`. Any Groq model that supports tool/function calling works.
GROQ_MODEL=openai/gpt-oss-120b

# ===== Local offline mode: Ollama (python main.py --local) ==================
# 1. Install:  curl -fsSL https://ollama.com/install.sh | sh
# 2. Pull a small tool-calling model:  ollama pull qwen2.5:3b   (or llama3.2:3b)
# 3. Recommended: give the model more context than the default, e.g.
#       OLLAMA_CONTEXT_LENGTH=8192 ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# Ollama ignores the key, but the openai SDK requires a non-empty string.
OLLAMA_API_KEY=ollama

# ===== Behaviour tuning (optional) ==========================================
# Sampling temperature: keep low for factual, deterministic answers.
LLM_TEMPERATURE=0.1
# Max tool-calling rounds per question before the agent gives up.
MAX_TOOL_ROUNDS=6
# Seconds to wait for the model to answer. Old CPUs running Ollama can be slow:
# raise LLM_TIMEOUT_LOCAL (e.g. 600) if you see "timed out" in --local mode.
LLM_TIMEOUT_CLOUD=60
LLM_TIMEOUT_LOCAL=300
# Timeout (seconds) for every allow-listed system command.
COMMAND_TIMEOUT=5
# Conversation history budget in characters (older turns are dropped first).
# Groq free tier has per-minute token limits; small local models have small
# context windows. Lower these if you hit limits.
HISTORY_CHAR_BUDGET_CLOUD=24000
HISTORY_CHAR_BUDGET_LOCAL=10000
# Real number of RAM slots on your motherboard (optional). Some BIOSes – many
# laptops, e.g. Lenovo G-series – report "phantom" slots (4 instead of 2).
# If the app shows more slots than your machine really has, set the true number:
# PHYSICAL_RAM_SLOTS=2
# Mock scenario used by --mock when --mock-scenario is not given:
#   laptop | laptop-nosudo | wsl2 | minimal
MOCK_SCENARIO=laptop
